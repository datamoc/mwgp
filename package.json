{
  "name": "rpgm-mwg-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local RPG Maker game launcher with an mw_games-ready runtime boundary.",
  "scripts": {
    "start": "node src/server.js",
    "scan": "node src/server.js --scan",
    "convert:mv": "node tools/convert-mv.js",
    "convert:auto": "node tools/convert-auto.js",
    "validate:mwgp": "node tools/validate-mwgp.js",
    "transpile:ruby": "node tools/transpile-ruby.mjs",
    "extract:rgssad": "node tools/extract-rgssad.js",
    "transpile:rgss": "node tools/transpile-rgss-scripts.mjs",
    "bundle:rgss": "node tools/bundle-rgss-scripts.mjs",
    "test": "node tools/test-smoke.mjs"
  },
  "dependencies": {
    "@datamoc/mw_games": "^0.16.0"
  }
}
